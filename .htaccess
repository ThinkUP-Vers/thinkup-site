# ============================================
# Think'UP - Configuration Apache / Hostinger
# ============================================
RewriteEngine On

# Charset UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .txt .md

# Type des versions Markdown des pages (generees au deploiement par
# editorial/generer-markdown.py). Sans cette ligne, Apache les servirait en
# application/octet-stream, donc en telechargement.
AddType text/markdown .md

# 1. Forcer le non-www (canonique = https://think-up.fr), en http comme en https.
# Placé AVANT la règle HTTPS : http://www passe ainsi par une seule redirection
# au lieu de deux (http://www -> https://www -> https://think-up.fr).
RewriteCond %{HTTP_HOST} ^www\.think-up\.fr$ [NC]
RewriteRule ^ https://think-up.fr%{REQUEST_URI} [L,R=301]

# 2. Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2b. Rediriger l'ancienne arborescence /thinkup-site/ vers la racine
RewriteRule ^thinkup-site/?$ https://think-up.fr/ [L,R=301]
RewriteRule ^thinkup-site/index\.html$ https://think-up.fr/ [L,R=301]
RewriteRule ^thinkup-site/(.+)$ https://think-up.fr/$1 [L,R=301]

# 2c. Rediriger l'ancienne page confidentialite
RewriteRule ^confidentialite\.html$ https://think-up.fr/politique-confidentialite.html [L,R=301]

# 2d. Pages fantômes / doublons supprimés (audit SEO juillet 2026)
RewriteRule ^index-iceberg\.html$ https://think-up.fr/methode.html [L,R=301]
RewriteRule ^mentions\.html$ https://think-up.fr/mentions-legales.html [L,R=301]
RewriteRule ^cas-clients\.html$ https://think-up.fr/resultats.html [L,R=301]
RewriteRule ^a-propos\.html$ https://think-up.fr/patrick.html [L,R=301]
RewriteRule ^taches-invisibles\.html$ https://think-up.fr/methode.html [L,R=301]
RewriteRule ^diagnostic-roi-ia\.html$ https://think-up.fr/offres.html [L,R=301]
RewriteRule ^gains-rapides-ia\.html$ https://think-up.fr/offres.html [L,R=301]
RewriteRule ^cadrage-adoption-ia\.html$ https://think-up.fr/offres.html [L,R=301]


# 2e. Slugs descriptifs des articles (refonte SEO aout 2026)
RewriteRule ^article-1\.html$ https://think-up.fr/erreurs-projets-ia-pme.html [L,R=301]
RewriteRule ^article-2\.html$ https://think-up.fr/calculer-roi-ia.html [L,R=301]
RewriteRule ^article-3\.html$ https://think-up.fr/taches-invisibles-cout-pme.html [L,R=301]
RewriteRule ^article-4\.html$ https://think-up.fr/choisir-consultant-ia.html [L,R=301]
RewriteRule ^article-5\.html$ https://think-up.fr/ia-pme-ce-qui-marche.html [L,R=301]
RewriteRule ^article-6\.html$ https://think-up.fr/chatgpt-nest-pas-une-strategie-ia.html [L,R=301]
RewriteRule ^article-7\.html$ https://think-up.fr/premier-cas-usage-ia.html [L,R=301]
RewriteRule ^article-8\.html$ https://think-up.fr/validation-humaine-ia.html [L,R=301]
RewriteRule ^article-9\.html$ https://think-up.fr/liberer-cinq-heures-par-semaine-ia.html [L,R=301]
RewriteRule ^article-10\.html$ https://think-up.fr/preparer-ses-donnees-ia.html [L,R=301]
RewriteRule ^article-11\.html$ https://think-up.fr/ai-act-rgpd-checklist-pme.html [L,R=301]

# 2f. Ancien chemin en sous-dossier /thinkup-site/ (URL fantomes relevees en Search Console le 09/11/2026)
RewriteRule ^thinkup-site/?$ https://think-up.fr/ [L,R=301]
RewriteRule ^thinkup-site/index\.html$ https://think-up.fr/ [L,R=301]
RewriteRule ^thinkup-site/a-propos\.html$ https://think-up.fr/patrick.html [L,R=301]
RewriteRule ^thinkup-site/cas-clients\.html$ https://think-up.fr/resultats.html [L,R=301]
RewriteRule ^thinkup-site/(.*)$ https://think-up.fr/$1 [L,R=301]

# 3. Page 404 personnalisee
ErrorDocument 404 /404.html

# 3b. Version Markdown des pages, pour les agents et les moteurs de reponse.
# Chaque page a un .md genere au deploiement (editorial/generer-markdown.py) :
# le contenu de <main>, sans navigation, scripts ni habillage. Deux facons de
# l'obtenir : l'adresse en .md, ou la meme adresse avec « Accept: text/markdown ».
#
# Ces regles passent AVANT la regle 4 : sinon /offres serait reecrit en
# /offres.html avant que la negociation ait pu jouer.
RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ index.md [L]

RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([^/.]+)\.html$ $1.md [L]

RewriteCond %{HTTP_ACCEPT} text/markdown
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([^/.]+)$ $1.md [L]

# La page HTML annonce elle-meme sa version Markdown dans un en-tete Link
# (RFC 8288, rel="alternate"). MD_SLUG est pose par mod_rewrite sans reecrire
# l'URL — substitution « - » — puis relu par mod_headers juste apres.
RewriteCond %{DOCUMENT_ROOT}/index.md -f
RewriteRule ^$ - [E=MD_SLUG:index]

RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^([^/.]+)\.html$ - [E=MD_SLUG:$1]

<IfModule mod_headers.c>
  Header set Link "<https://think-up.fr/%{MD_SLUG}e.md>; rel=\"alternate\"; type=\"text/markdown\"" env=MD_SLUG

  # La reponse depend de l'en-tete Accept. Sans Vary, un cache ou un
  # intermediaire pourrait servir le Markdown a un navigateur, ou l'inverse.
  <FilesMatch "\.(html|md)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# 4. Acces sans .html : /offres sert /offres.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^\.]+)$ $1.html [L]

# 5. Compression Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6b. Cache-Control immutable sur les assets statiques
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 7. Headers de securite
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 8. Proteger les fichiers et dossiers sensibles
RewriteRule (^|/)\.git(/|$) - [F,L]
# editorial-content/ et scheduled-blog/ ont ete deplaces dans editorial/ le
# 05/11/2026 : les deux anciennes regles, ancrees sur le chemin racine, ne
# correspondaient donc plus a rien. Un seul verrou sur le dossier parent les
# remplace. Rien sous editorial/ n a vocation a etre servi : les brouillons
# d articles y attendent leur date et la publication se fait depuis le depot
# via GitHub Actions, jamais par un appel HTTP au serveur.
RewriteRule ^editorial/ - [F,L]
<Files "publish-blog.php">
  Require all denied
</Files>
<FilesMatch "\.(htaccess|json|gitignore)$">
  Require all denied
</FilesMatch>

# Les .md etaient tous bloques ici. Depuis le 20/11/2026, chaque page du site
# a une version Markdown (offres.md, faq.md…) generee au deploiement et servie
# aux agents : le verrou ne porte donc plus que sur la documentation interne du
# depot, qui est de surcroit deja exclue du transfert FTP.
<FilesMatch "^(CLAUDE|DEPLOIEMENT-BOUTIQUE|MENTIONS-TIERCES-GEO)\.md$">
  Require all denied
</FilesMatch>
